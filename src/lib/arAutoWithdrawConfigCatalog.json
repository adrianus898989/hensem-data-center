  "fields": [
    {
      "key": "autoWithdraw",
      "kind": "boolean",
      "label": "是否启用自动出款",
      "description": "",
      "section": "root",
      "enabledBy": [],
      "unit": "boolean"
    },
    {
      "key": "withdrawAmount",
      "kind": "number",
      "label": "提现金额<=",
      "description": "",
      "section": "config",
      "enabledBy": [
        "autoWithdraw"
      ],
      "unit": "amount"
    },
    {
      "key": "totalLoss",
      "kind": "number",
      "label": "总提款/总充值<=",
      "description": "例:配置2.1则代表总提现大于总充值金额的2.1倍则不能自动出款",
      "section": "config",
      "enabledBy": [
        "autoWithdraw"
      ],
      "unit": "multiple"
    },
    {
      "key": "withdrawTimes",
      "kind": "number",
      "label": "无充值连续提现次数<",
      "description": "例:配置2则代表上次充值后已经提款过1次的不能自动出款",
      "section": "config",
      "enabledBy": [
        "autoWithdraw"
      ],
      "unit": "count"
    },
    {
      "key": "grandWithdrawTotal",
      "kind": "number",
      "label": "累计提款次数>=",
      "description": "例:配置5则代表累计提款次数小于5次的不能自动出款",
      "section": "config",
      "enabledBy": [
        "autoWithdraw"
      ],
      "unit": "count"
    },
    {
      "key": "todayProfitAmount",
      "kind": "number",
      "label": "当日盈利金额>=",
      "description": "当日派彩金额-当日投注金额大于等于填写的不能自动出款",
      "section": "config",
      "enabledBy": [
        "autoWithdraw"
      ],
      "unit": "amount"
    },
    {
      "key": "manualRechargeAmount",
      "kind": "number",
      "label": "3日内人工充值(人工)>=",
      "description": "3日内人工充值金额大于等于填写值的不能自动出款(0:则不限制)",
      "section": "config",
      "enabledBy": [
        "autoWithdraw"
      ],
      "unit": "amount"
    },
    {
      "key": "bonusRechargeAmount",
      "kind": "number",
      "label": "3日内人工充值(彩金)>=",
      "description": "3日内人工充值彩金金额大于等于填写值的不能自动出款(0:则不限制)",
      "section": "config",
      "enabledBy": [
        "autoWithdraw"
      ],
      "unit": "amount"
    },
    {
      "key": "accountBalance",
      "kind": "number",
      "label": "账号余额>=",
      "description": "账号余额大于等于填写值的不能自动出款",
      "section": "config",
      "enabledBy": [
        "autoWithdraw"
      ],
      "unit": "amount"
    },
    {
      "key": "firstDepositAmount",
      "kind": "number",
      "label": "首存金额>=",
      "description": "账号首充存款金额大于等于填写值的不能自动出款",
      "section": "config",
      "enabledBy": [
        "autoWithdraw"
      ],
      "unit": "amount"
    },
    {
      "key": "sameDeviceAccountCount",
      "kind": "number",
      "label": "同设备数>=",
      "description": "同设备数大于等于填写值的不能自动出款",
      "section": "config",
      "enabledBy": [
        "autoWithdraw"
      ],
      "unit": "count"
    },
    {
      "key": "dayWithdrawLimit",
      "kind": "number",
      "label": "当日出款笔数>=",
      "description": "当日出款笔数大于等于配置的值时不能自动出款(0:则不限制)",
      "section": "config",
      "enabledBy": [
        "autoWithdraw"
      ],
      "unit": "count"
    },
    {
      "key": "lastRechargeDayLimit",
      "kind": "number",
      "label": "最后一次充值时间>",
      "description": "例: 配置5,则代表(当前日期 - 最后一次充值日期)的天数大于配置的值,不能出款（0:则不限制）",
      "section": "config",
      "enabledBy": [
        "autoWithdraw"
      ],
      "unit": "days"
    },
    {
      "key": "isOpenAgentRedLimit",
      "kind": "boolean",
      "label": "代理红包自动出款条件",
      "description": "",
      "section": "config",
      "enabledBy": [
        "autoWithdraw"
      ],
      "unit": "boolean"
    },
    {
      "key": "maxRedRechargeRate",
      "kind": "number",
      "label": "红包总额 / 总充值金额>=",
      "description": "（此处配置的是百分比，红包总金额 ÷ 总充值金额 ≥ 设置比例时不能自动出款，例如输入: 10 = 10%）",
      "section": "agent_red_limits",
      "enabledBy": [
        "autoWithdraw",
        "isOpenAgentRedLimit"
      ],
      "unit": "percent"
    },
    {
      "key": "receiveRedSumAmount",
      "kind": "number",
      "label": "历史红包领取总额>=",
      "description": "代理红包历史领取总额，大于该值则不能自动出款（0 表示不限制）",
      "section": "agent_red_limits",
      "enabledBy": [
        "autoWithdraw",
        "isOpenAgentRedLimit"
      ],
      "unit": "amount"
    },
    {
      "key": "lastRechgRecvReadSumAmount",
      "kind": "number",
      "label": "最后一次充值红包领取总金额>=",
      "description": "从上一次充值到本次提现区间内领取的红包总额（0 表示不限制）",
      "section": "agent_red_limits",
      "enabledBy": [
        "autoWithdraw",
        "isOpenAgentRedLimit"
      ],
      "unit": "amount"
    },
    {
      "key": "allowvirtualwithdraw",
      "kind": "boolean",
      "label": "是否允许非法定货币出款",
      "description": "开关打开时，任何需要转换汇率的出款方式都可以自动出款，如 USDT、TRX 等",
      "section": "config",
      "enabledBy": [
        "autoWithdraw"
      ],
      "unit": "boolean"
    },
    {
      "key": "betTurnoverMultiple",
      "kind": "number",
      "label": "打码倍数<=",
      "description": "打码倍数小于等于填写值的不能自动出款（若在不满足打码倍数的前提下，满足下方充提负盈利条件也可自动出款，0 表示不限制）",
      "section": "config",
      "enabledBy": [
        "autoWithdraw"
      ],
      "unit": "multiple"
    },
    {
      "key": "isOpenRevisitPoorProfit",
      "kind": "boolean",
      "label": "充提差负盈利开关",
      "description": "",
      "section": "config",
      "enabledBy": [
        "autoWithdraw"
      ],
      "unit": "boolean"
    },
    {
      "key": "revisitPoorProfitAmount",
      "kind": "number",
      "label": "充提差负盈利>=",
      "description": "负盈利计算公式(历史充值总额 - 历史提现总额 - 待处理金额 - 账号余额)=负盈利价值大于等于配置值的时候自动出款(可以输入正负数或者小数)",
      "section": "revisit_poor_profit",
      "enabledBy": [
        "autoWithdraw",
        "isOpenRevisitPoorProfit"
      ],
      "unit": "amount"
    },
    {
      "key": "firstRecharge",
      "kind": "boolean",
      "label": "是否需要完成首充",
      "description": "开关打开需要会员完成首充才能自动出款",
      "section": "config",
      "enabledBy": [
        "autoWithdraw"
      ],
      "unit": "boolean"
    },
    {
      "key": "checkRemark",
      "kind": "boolean",
      "label": "是否判断会员备注",
      "description": "开关打开需要会员备注无内容才能自动出款",
      "section": "config",
      "enabledBy": [
        "autoWithdraw"
      ],
      "unit": "boolean"
    },
    {
      "key": "limitGroup",
      "kind": "boolean",
      "label": "是否限定用户分组",
      "description": "开关打开需要选中的分组才能自动出款",
      "section": "config",
      "enabledBy": [
        "autoWithdraw"
      ],
      "unit": "boolean"
    },
    {
      "key": "isAutoPayment",
      "kind": "boolean",
      "label": "是否启用自动下款",
      "description": "开启,则自动出款,关闭,符合条件的出款进入建议页签",
      "section": "config",
      "enabledBy": [
        "autoWithdraw"
      ],
      "unit": "boolean"
    },
    {
      "key": "isCurrencyLimit",
      "kind": "boolean",
      "label": "是否限制币种和上一笔入款币种一致",
      "description": "开启,需要判断最近一笔入款和出款的币种一致才能出款",
      "section": "config",
      "enabledBy": [
        "autoWithdraw"
      ],
      "unit": "boolean"
    },
    {
      "key": "isBankCardToArPay",
      "kind": "boolean",
      "label": "Bank(银行卡)提现是否走AR钱包出款",
      "description": "(若开启该开关,满足自动出款条件的Bank提现订单会自动提交到AR钱包出款)",
      "section": "config",
      "enabledBy": [
        "autoWithdraw"
      ],
      "unit": "boolean"
    },
    {
      "key": "isGameNegativeProfitLimit",
      "kind": "boolean",
      "label": "isGameNegativeProfitLimit（页面未提供）",
      "description": "保存脚本引用该 ID，但提供的 HTML 中没有对应输入项；值未知，不视为关闭。",
      "section": "not_present",
      "enabledBy": [],
      "unit": "boolean"
    }
  ],
  "groups": [
    {
      "key": "userGroups",
      "label": "限定用户分组",
      "description": "开关打开需要选中的分组才能自动出款",
      "enabledBy": [
        "autoWithdraw",
        "limitGroup"
      ]
    },
    {
      "key": "gameTypes",
      "label": "限制游戏类型不可自动出款",
      "description": "(选中的游戏类型，若本次的打码有对应游戏的注单，则不能自动出款)",
      "enabledBy": [
        "autoWithdraw"
      ]
    }
  ]
}
